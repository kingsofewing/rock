# macOS
.DS_Store
**/.DS_Store

# Editor / OS cruft
Thumbs.db
*.swp
# LibreOffice lock files + temp copies of open workbooks — these can be
# unencrypted snapshots of private data, and the site is publicly served.
.~lock.*#
*.tmp

# Build / backup cruft
**/__pycache__/
*.bak
*.bak2

# Mailing list — keep local, never publish
docs/sources/mailing_list.xlsx

# Oh Canada folder — only publish the HTML pages, keep md/pdf/xlsx/etc local
docs/canada 2026/*
!docs/canada 2026/*.html
